# Applies to static assets only. Worker-rendered HTML does not pass through
# this file, so document security headers live in a Cloudflare Transform Rule.

/*
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/cards/*
  Cache-Control: public, max-age=31536000, immutable

/og.png
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

# vinext generates this rule, but this file replaces its output.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
